{
	"semi": true,
	"endOfLine": "auto",
	"tabWidth": 4,
	"useTabs": true,
	"printWidth": 120,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"quoteProps": "consistent",
	"trailingComma": "es5",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"htmlWhitespaceSensitivity": "strict",
	"vueIndentScriptAndStyle": false,
	"singleAttributePerLine": false,
	"plugins": ["prettier-plugin-organize-imports"]
}
