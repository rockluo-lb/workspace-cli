{
  "name": "vibe-flow-cli",
  "version": "0.1.0",
  "description": "Jira-driven step-based vibe coding workflow CLI",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "bin": {
    "vibe": "./dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx ./src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "ink": "^6.2.3",
    "pino": "^9.7.0",
    "react": "^19.2.5",
    "simple-git": "^3.36.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "4.1.5"
  }
}
